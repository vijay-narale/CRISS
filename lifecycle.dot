digraph Lifecycle {
    rankdir=LR;
    nodesep=0.5;
    ranksep=0.6;
    bgcolor="#ffffff";
    node [fontname="Arial", fontsize=9, shape=box, style="rounded,filled"];
    edge [fontname="Arial", fontsize=8, color="#334155"];

    subgraph cluster_resv {
        label = "Reservation Lifecycle State Machine";
        style = "filled";
        color = "#0284c7";
        fillcolor = "#f0f9ff";
        fontname = "Arial Bold";
        fontsize = 10;

        R_Start [label="Start Hold Request", shape=circle, fillcolor="#0284c7", fontcolor="#ffffff", width=0.4];
        R_Pending [label="pending_approval
(Approval Required / Student)", fillcolor="#fef3c7", color="#d97706"];
        R_Confirmed [label="confirmed
(Copy Locked: FOR UPDATE)", fillcolor="#dcfce7", color="#16a34a"];
        R_Cancelled [label="cancelled
(Released back to pool)", fillcolor="#f1f5f9", color="#475569"];
        R_Rejected [label="rejected
(Declined by Coordinator)", fillcolor="#fee2e2", color="#dc2626"];
        R_Fulfilled [label="fulfilled
(Converted to Loan)", fillcolor="#e0f2fe", color="#0284c7"];

        R_Start -> R_Pending [label="Requires Approval=TRUE"];
        R_Start -> R_Confirmed [label="Auto-Approved"];
        R_Pending -> R_Confirmed [label="Admin / Faculty Approves"];
        R_Pending -> R_Rejected [label="Admin Declines"];
        R_Confirmed -> R_Cancelled [label="User / Admin Cancels"];
        R_Pending -> R_Cancelled [label="User Cancels"];
        R_Confirmed -> R_Fulfilled [label="Issued at Circulation Desk"];
    }

    subgraph cluster_loan {
        label = "Circulation Loan Lifecycle State Machine";
        style = "filled";
        color = "#0d9488";
        fillcolor = "#f0fdfa";
        fontname = "Arial Bold";
        fontsize = 10;

        L_Checkout [label="Physical Checkout
(Copy -> 'on_loan' via Trigger)", fillcolor="#ccfbf1", color="#0d9488"];
        L_Active [label="active
(Due date tracked)", fillcolor="#dcfce7", color="#16a34a"];
        L_Overdue [label="overdue
(Due date exceeded;
Borrower blocked)", fillcolor="#fee2e2", color="#dc2626"];
        L_Returned_Good [label="returned (Good / Fair)
(Copy -> 'available' via Trigger)", fillcolor="#dcfce7", color="#16a34a"];
        L_Returned_Maint [label="returned (Needs Maintenance)
(Copy -> 'maintenance';
Ticket created)", fillcolor="#f3e8ff", color="#9333ea"];

        R_Fulfilled -> L_Checkout [label="Circulation Scan", style="dashed", color="#0284c7"];
        L_Checkout -> L_Active [label="Loan Active"];
        L_Active -> L_Overdue [label="NOW() > due_date
(Daily Overdue Scan)"];
        L_Active -> L_Returned_Good [label="Return (Normal)"];
        L_Active -> L_Returned_Maint [label="Return (Damaged)"];
        L_Overdue -> L_Returned_Good [label="Late Return (Fine Assessed)"];
        L_Overdue -> L_Returned_Maint [label="Late Return (Damaged)"];
    }
}
