# CRISS - Campus Resource Intelligence & Sharing System
# Environment Configuration Template

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=criss-super-secret-key-change-in-production-2026

# MySQL Database Configuration
# Default port is 3306 for standard MySQL Server, or 3308 for local development instance
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=criss_db
MYSQL_POOL_SIZE=5
